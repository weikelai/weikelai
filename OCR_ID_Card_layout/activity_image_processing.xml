<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" tools:context=".ImageProcessing">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:maxHeight="400dp"
                android:contentDescription="身份证图片"
                tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/nameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="姓名: "
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sexTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="性别: "
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nationTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="民族: "
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/birthTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="出生日期: "
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/addressTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="地址: "
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/idNumTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="身份证号: "
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>